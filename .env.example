# Node 24+. Never commit real credentials.
PORT=3000
HOST=0.0.0.0
APP_ORIGIN=http://localhost:3000
DATA_DIR=./data
# Set NODE_ENV=production only behind HTTPS; session cookies then require HTTPS.
# TRUST_PROXY=1 only with exactly one trusted reverse proxy, inaccessible directly.

# Optional shared Supabase backend for GitHub Pages. Public browser keys only.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_your-public-key
# Never use service_role, sb_secret_ keys or database passwords here.
